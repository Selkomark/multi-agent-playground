# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required for a real run.
ANTHROPIC_API_KEY=

# Optional: model used by every agent (default: claude-opus-5-5)
# DOMAIN_RESEARCH_MODEL=claude-opus-5-5

# Provider credentials. A provider without credentials reports every domain as "unknown".
# GoDaddy: personal access token with the domains.domain:read scope
GODADDY_PAT=
# Name.com: account username and API token
NAMECOM_USERNAME=
NAMECOM_TOKEN=
# Porkbun: API key pair
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
